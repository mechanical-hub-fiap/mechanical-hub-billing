<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Logs em JSON (engineering/logging-standard.md). MDC (orderId, transactionId, eventId, mpOrderId,
         trace_id/span_id do agente) vai como campos; `service` e fixo por servico. -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"mechanical-hub-billing"}</customFields>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>
</configuration>
